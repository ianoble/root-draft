{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engine/client": [
        "noble-bg-engine/packages/engine/src/client/index.ts",
        "../noble-bg-engine/packages/engine/src/client/index.ts",
        "../noblegames/noble-bg-engine/packages/engine/src/client/index.ts"
      ],
      "@engine/*": [
        "noble-bg-engine/packages/engine/src/*",
        "../noble-bg-engine/packages/engine/src/*",
        "../noblegames/noble-bg-engine/packages/engine/src/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts", "vitest.config.ts", "engine-root.ts"]
}
